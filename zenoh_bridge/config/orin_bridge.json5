{
  // ============================================================
  // Zenoh Bridge Config — AGX ORIN
  // ROS2: Jazzy | Ubuntu 24.04
  // Role: ROUTER — both Laptop and NUC connect here
  // Run: zenoh-bridge-ros2dds --config config/orin_bridge.json5
  // ============================================================

  mode: "router",

  listen: {
    endpoints: ["tcp/0.0.0.0:7447"]
  },

  plugins: {
    ros2dds: {
      ros2_namespace: "",
      ros2_domain_id: 0,

      // Receive sensor data from Laptop → publish to local ROS2 for VLA
      sub_topics: [
        "/localization/kinematic_state",
        "/perception/object_recognition/detection/tensorrt_yolox_node/out/image",
        "/sensing/camera/camera0/image_raw/compressed"
      ],

      // Forward VLA output → Zenoh → NUC
      // Update topic names here once VLA output topics are confirmed
      pub_topics: [
        "/vla/deceleration_cmd",
        "/vla/brake_cmd",
        "/vla/safety_status"
      ]
    }
  }
}
